# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these values from your Supabase project dashboard:
#   1. Go to supabase.com and open your project
#   2. Click "Project Settings" (gear icon) in the left sidebar
#   3. Click "API" under Configuration
#   4. Copy the values below
#
# NEXT_PUBLIC_ prefix means these are safe to use in browser code.
# They're "public" keys — they identify your project but don't grant admin access.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# AI question box
# =============================================================================
# Groq's free tier: 30 requests/minute, 200K tokens/day, open-weight models on
# their own hardware, and no data retention by default. No card required.
#   1. Sign in at https://console.groq.com
#   2. Create a key under API Keys
#   3. Paste it below (and add it to Vercel's environment variables to deploy)
#
# NO NEXT_PUBLIC_ PREFIX. This key must never reach the browser — it is read
# only by the server-side route at app/api/ask/route.ts.
#
# The client is plain OpenAI-compatible fetch with no SDK, so moving to
# Cerebras or OpenRouter is these two variables and nothing else. Worth knowing:
# free tiers do disappear — GitHub Models was retired on 30 July 2026.
# =============================================================================

AI_API_KEY=your-groq-key-here
AI_BASE_URL=https://api.groq.com/openai/v1
# Optional: the code defaults to openai/gpt-oss-120b. Set this only to
# override, e.g. if Groq retires that model (they do this without notice).
AI_MODEL=openai/gpt-oss-120b
